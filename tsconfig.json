{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/pages/api/*": ["pages/api/*"],
      "@/styles/*": ["styles/*"],
      "@/types/*": ["types/*"],
      "@/tests/*": ["tests/*"],
      "@/__tests__/*": ["__tests__/*"],
      "@/__mocks__/*": ["__mocks__/*"],
    }
  },
  "include": [
    "next-env.d.ts", 
    "**/*.ts", "**/*.tsx", 
    "components/*.tsx", "pages/Tracker/Perfection.tsx", "pages/Villagers/[villagername].js", "__tests__/Login.test.jsx", "__tests__/mocks/handlers.jsx", "__mocks__/lib/mongodb.js", 
    /*"components/CheckDropdown.tsx", "components/FishCard.jsx", "components/CheckCard.tsx", "components/CheckCard.tsx", "components/IconLink.tsx", "components/InlineList.tsx",*/
  ],
  "exclude": ["node_modules"]
}
