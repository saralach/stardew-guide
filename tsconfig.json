{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/pages/api/*": ["pages/api/*"],
      "@/styles/*": ["styles/*"],
      "@/types/*": ["types/*"],
      "@/tests/*": ["tests/*"],
      "@/__tests__/*": ["__tests__/*"],
      "@/__mocks__/*": ["__mocks__/*"],
      "@/jest/*": ["jest/*"],
    }
  },
  "include": [
    "next-env.d.ts", 
    "**/*.ts", "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
